---
import "../styles/global.css";

interface Props {
  title?: string;
}
const { title = "Playground Hà Nội" } = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#047857" />
    <meta name="description" content="Theo dõi thời gian ngoài trời, chạm thiên nhiên và thử thách vận động của bé mỗi ngày." />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body class="safe-x bg-stone-50 text-stone-800 antialiased min-h-dvh">
    <slot />
  </body>
</html>
