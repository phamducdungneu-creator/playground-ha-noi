---
import type { Place } from "../data/places";
import { KIND_LABEL, mapsUrl } from "../data/placeDirectory";

const AGE: Record<string, string> = { "1-3": "1–3 tuổi", "4-6": "4–6 tuổi", "7-10": "7–10 tuổi" };
const { places } = Astro.props as { places: Place[] };
---

<ul class="space-y-2">
  {places.map((p) => {
    const k = KIND_LABEL[p.kind ?? "park"] ?? KIND_LABEL.park;
    return (
      <li class="rounded-2xl bg-white border border-stone-200 p-4 space-y-1.5">
        <div class="flex items-start gap-2">
          <span aria-hidden="true" class="text-xl leading-none">{k.icon}</span>
          <div class="min-w-0 flex-1">
            <h3 class="text-sm font-bold text-stone-800">{p.name}</h3>
            <p class="text-xs text-stone-500">{k.label} · {p.address}{p.free === true && " · Miễn phí"}</p>
          </div>
          <a href={mapsUrl(p)} target="_blank" rel="noopener" class="shrink-0 text-xs font-semibold text-emerald-700 underline">Chỉ đường</a>
        </div>
        {p.tags.filter((t) => t.label !== k.label).length > 0 && (
          <p class="text-xs text-stone-600">{p.tags.filter((t) => t.label !== k.label).map((t) => `${t.icon} ${t.label}`).join(" · ")}</p>
        )}
        {p.exercises.length > 0 && (
          <ul class="text-xs text-stone-600 list-disc pl-5">
            {p.exercises.map((e) => <li><span class="font-semibold">{AGE[e.group]}:</span> {e.text}</li>)}
          </ul>
        )}
      </li>
    );
  })}
</ul>
