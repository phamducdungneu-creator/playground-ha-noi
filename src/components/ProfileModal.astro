---
// Overview of the active child: age group, completed exercises, outdoor hours, siblings.
---

<dialog id="profileModal"
  class="m-auto w-[min(28rem,calc(100vw-2rem))] max-h-[85dvh] rounded-3xl p-0 shadow-2xl backdrop:bg-stone-900/40 backdrop:backdrop-blur-sm">
  <div class="p-5 space-y-4">
    <div class="flex items-start gap-3">
      <span id="pfAvatar" class="w-16 h-16 rounded-2xl bg-amber-100 grid place-items-center text-4xl shrink-0"></span>
      <div class="flex-1 min-w-0">
        <h2 id="pfName" class="text-xl font-extrabold text-stone-800 truncate"></h2>
        <p id="pfMeta" class="text-sm text-stone-500"></p>
      </div>
      <button type="button" data-close class="w-9 h-9 rounded-full hover:bg-stone-100 text-stone-500" aria-label="Đóng">✕</button>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div class="rounded-2xl bg-emerald-50 p-3">
        <p class="text-xs text-emerald-800">Thử thách đã xong</p>
        <p class="text-2xl font-extrabold text-emerald-900"><span id="pfDone">0</span> 🌿</p>
      </div>
      <div class="rounded-2xl bg-amber-50 p-3">
        <p class="text-xs text-amber-900">Giờ ngoài trời</p>
        <p class="text-2xl font-extrabold text-amber-900"><span id="pfHours">0</span> giờ</p>
        <div class="mt-1 flex gap-1">
          <button type="button" data-hours="0.5" class="text-xs px-2 py-1 rounded-lg bg-white text-amber-900 font-semibold">+30 phút</button>
          <button type="button" data-hours="1" class="text-xs px-2 py-1 rounded-lg bg-white text-amber-900 font-semibold">+1 giờ</button>
        </div>
      </div>
    </div>

    <div class="rounded-2xl border border-stone-200 p-3">
      <div class="flex items-center justify-between gap-2 mb-1.5">
        <p class="text-sm font-semibold text-stone-700">🩺 Thể trạng cơ xương khớp</p>
        <button type="button" id="pfHealth" class="text-xs font-semibold text-emerald-800 bg-emerald-50 rounded-lg px-2.5 py-1">Cập nhật</button>
      </div>
      <div id="pfHealthBody" class="text-sm space-y-1"></div>
    </div>

    <div>
      <p class="text-sm font-semibold text-stone-700 mb-2">Đã chinh phục</p>
      <ul id="pfList" class="space-y-1.5 text-sm"></ul>
    </div>

    <div class="flex gap-2">
      <button type="button" id="pfEdit" class="flex-1 h-11 rounded-xl bg-stone-100 text-stone-700 font-semibold">✎ Sửa hồ sơ</button>
      <button type="button" data-close class="flex-1 h-11 rounded-xl bg-emerald-700 text-white font-bold">Xong</button>
    </div>
  </div>
</dialog>

<script>
  import { useMemberStore, ageOf, ageGroupOf } from "../stores/memberStore";
  import { exerciseById } from "../data/places";
  import { conditionById, groupById } from "../data/conditions";

  const dialog = document.getElementById("profileModal") as HTMLDialogElement;
  const $ = (id: string) => document.getElementById(id)!;

  function render() {
    const c = useMemberStore.activeChild();
    if (!c) return;
    const age = ageOf(c);
    $("pfAvatar").textContent = c.animal;
    $("pfName").textContent = c.nickname;
    $("pfMeta").textContent = `Sinh năm ${c.birth_year} · ${age} tuổi · nhóm ${ageGroupOf(age)}`;
    $("pfDone").textContent = String(c.completed_exercises.length);
    $("pfHours").textContent = String(c.outdoor_hours);

    const hs = c.health_screening;
    const hb = $("pfHealthBody");
    hb.innerHTML = "";
    const line = (text: string, cls = "text-stone-700") => {
      const p = document.createElement("p");
      p.className = cls;
      p.textContent = text;
      hb.appendChild(p);
    };
    if (!hs.screened) line("⚠️ Chưa sàng lọc — hoàn thiện để nhận gợi ý sân chơi phù hợp.", "text-amber-800 text-xs");
    else if (!hs.selected_condition_ids.length) line("✅ Không ghi nhận dấu hiệu bất thường.", "text-emerald-800 text-xs");
    else {
      for (const id of hs.selected_condition_ids) {
        const cond = conditionById.get(id);
        if (cond) line(`${groupById.get(cond.group)?.icon ?? "•"} ${cond.name_vi}`);
      }
    }
    if (hs.notes) line(`📝 ${hs.notes}`, "text-xs text-stone-500");
    const list = $("pfList");
    list.innerHTML = "";
    if (!c.completed_exercises.length) {
      list.innerHTML = `<li class="text-stone-500 text-sm">Chưa có thử thách nào — ra sân chơi thôi! 🏃</li>`;
    }
    for (const id of c.completed_exercises) {
      const ex = exerciseById.get(id);
      if (!ex) continue;
      const li = document.createElement("li");
      li.className = "flex items-start gap-2 rounded-xl bg-stone-50 px-3 py-2";
      li.innerHTML = `<span>✅</span><span><span class="block text-stone-800"></span><span class="block text-xs text-stone-500"></span></span>`;
      const [t, p] = li.querySelectorAll("span span");
      t.textContent = ex.text;
      p.textContent = ex.place;
      list.appendChild(li);
    }
  }

  useMemberStore.subscribe(() => dialog.open && render());
  window.addEventListener("cham:profile-modal", () => {
    render();
    dialog.showModal();
  });
  dialog.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    const h = t.closest<HTMLElement>("[data-hours]");
    if (h) return useMemberStore.addOutdoorHours(Number(h.dataset.hours));
    if (t.id === "pfHealth") {
      dialog.close();
      window.dispatchEvent(new CustomEvent("cham:health-modal", { detail: { id: useMemberStore.activeChild()?.id } }));
      return;
    }
    if (t.id === "pfEdit") {
      dialog.close();
      window.dispatchEvent(new CustomEvent("cham:child-modal", { detail: { id: useMemberStore.activeChild()?.id } }));
      return;
    }
    if (t === dialog || t.closest("[data-close]")) dialog.close();
  });
</script>
