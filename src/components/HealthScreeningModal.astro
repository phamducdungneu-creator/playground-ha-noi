---
import { DISCLAIMER } from "../data/conditions";
import { CLUSTERS, MSK_CONDITIONS } from "../data/msk";
import { articleByCondition } from "../data/clinicalReference";

// same list, order and grouping as the quick test and the reference hub
const items = (cluster: string) => MSK_CONDITIONS.filter((c) => c.cluster === cluster);
---

<dialog id="healthModal"
  class="m-auto mb-0 sm:mb-auto w-full sm:w-[min(34rem,calc(100vw-2rem))] max-w-none sm:max-w-[34rem] max-h-[94dvh] rounded-t-3xl sm:rounded-3xl p-0 shadow-2xl backdrop:bg-stone-900/40 backdrop:backdrop-blur-sm">
  <form id="healthForm" class="flex flex-col max-h-[94dvh]">
    <!-- header -->
    <div class="shrink-0 px-5 pt-4 pb-3 border-b border-stone-100">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p id="hsStep" class="text-[11px] font-semibold uppercase tracking-wider text-emerald-700"></p>
          <h2 class="text-lg font-extrabold text-stone-800">Sàng lọc thể trạng <span id="hsName" class="text-emerald-800"></span></h2>
          <p class="text-xs text-stone-500">Tích những dấu hiệu bố mẹ quan sát thấy ở bé. Không chắc thì bỏ qua.</p>
        </div>
        <button type="button" id="hsClose" class="w-9 h-9 shrink-0 rounded-full hover:bg-stone-100 text-stone-500" aria-label="Đóng">✕</button>
      </div>
      <p class="mt-2 text-[11px] leading-snug rounded-xl bg-amber-50 text-amber-900 px-3 py-2">⚕️ {DISCLAIMER}</p>
    </div>

    <!-- body -->
    <div class="flex-1 overflow-y-auto overscroll-contain px-4 py-3 space-y-2">
      <p id="hsAgeNote" class="px-1 text-[11px] text-stone-500"></p>
      {CLUSTERS.map((g, gi) => (
        <details class="hs-group group rounded-2xl border border-stone-200 bg-white open:border-emerald-200 open:shadow-sm" open={gi === 0} data-group={g.id}>
          <summary class="flex items-center gap-3 px-3 py-3 cursor-pointer list-none select-none">
            <span class="w-9 h-9 rounded-xl bg-emerald-50 grid place-items-center text-lg shrink-0">{g.icon}</span>
            <span class="flex-1 min-w-0">
              <span class="block text-sm font-bold text-stone-800">{g.label}</span>
              <span class="hs-total block text-[11px] text-stone-500"></span>
            </span>
            <span class="hs-count hidden text-xs font-bold bg-emerald-700 text-white rounded-full min-w-6 h-6 px-2 grid place-items-center"></span>
            <svg class="w-4 h-4 text-stone-400 transition group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4Z"/></svg>
          </summary>
          <div class="px-2 pb-2 space-y-1.5">
            {items(g.id).map((c) => (
              <label class="hs-item flex gap-3 p-2.5 rounded-xl cursor-pointer hover:bg-stone-50 has-[:checked]:bg-emerald-50 has-[:checked]:ring-1 has-[:checked]:ring-emerald-200"
                data-stages={articleByCondition.get(c.id)!.testGuide.stages.join(" ")}>
                <input type="checkbox" name="condition" value={c.id} data-group={g.id}
                  class="mt-0.5 w-5 h-5 shrink-0 accent-emerald-700" />
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-stone-800">{c.nameVi} <span class="hs-dx hidden text-[10px] font-bold uppercase text-sky-800 bg-sky-50 rounded px-1.5 py-0.5 align-middle">đã chẩn đoán</span></span>
                  <span class="block text-[11px] italic text-stone-400">{c.term}</span>
                  <span class="block text-xs text-stone-600 mt-0.5">{articleByCondition.get(c.id)!.riskState.description}</span>
                </span>
              </label>
            ))}
          </div>
        </details>
      ))}

      <label class="flex gap-3 p-3 rounded-2xl border border-dashed border-stone-300 cursor-pointer has-[:checked]:border-emerald-600 has-[:checked]:bg-emerald-50">
        <input type="checkbox" id="hsNone" class="mt-0.5 w-5 h-5 shrink-0 accent-emerald-700" />
        <span>
          <span class="block text-sm font-semibold text-stone-800">Bé không có dấu hiệu nào ở trên</span>
          <span class="block text-xs text-stone-500">Ứng dụng sẽ gợi ý sân chơi theo khoảng cách và độ tuổi.</span>
        </span>
      </label>

      <label class="block space-y-1.5 pt-1">
        <span class="text-sm font-semibold text-stone-700">Ghi chú thêm <span class="font-normal text-stone-400">(không bắt buộc)</span></span>
        <textarea id="hsNotes" rows="2" maxlength="300" placeholder="VD: bác sĩ đã chẩn đoán, đang đi giày chỉnh hình, mức độ…"
          class="w-full rounded-xl border border-stone-200 px-3 py-2 text-sm outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100"></textarea>
      </label>
    </div>

    <!-- footer -->
    <div class="safe-bottom shrink-0 px-4 pt-3 border-t border-stone-100 bg-white">
      <p id="hsSummary" class="text-xs text-stone-500 mb-2"></p>
      <div class="flex gap-2">
        <button type="button" id="hsCancel" class="flex-1 h-11 rounded-xl bg-stone-100 text-stone-700 font-semibold">Để sau</button>
        <button type="submit" id="hsSave" class="flex-[2] h-11 rounded-xl bg-emerald-700 hover:bg-emerald-800 disabled:bg-stone-300 text-white font-bold">Lưu & xem sân phù hợp</button>
      </div>
    </div>
  </form>
</dialog>

<script>
  import { useMemberStore, ageMonthsOf } from "../stores/memberStore";
  import { affectedGroups } from "../lib/recommend";
  import { stageOf, STAGES } from "../data/msk";

  const dialog = document.getElementById("healthModal") as HTMLDialogElement;
  const form = document.getElementById("healthForm") as HTMLFormElement;
  const none = document.getElementById("hsNone") as HTMLInputElement;
  const notes = document.getElementById("hsNotes") as HTMLTextAreaElement;
  const boxes = [...form.querySelectorAll<HTMLInputElement>("input[name=condition]")];
  const groups = [...form.querySelectorAll<HTMLDetailsElement>(".hs-group")];
  const $ = (id: string) => document.getElementById(id)!;
  let childId: string | null = null;
  let required = false;

  const visible = () => boxes.filter((b) => !b.closest<HTMLElement>(".hs-item")!.hidden);
  const checkedIds = () => visible().filter((b) => b.checked).map((b) => Number(b.value));

  function refresh() {
    const ids = checkedIds();
    groups.forEach((g) => {
      const inGroup = visible().filter((b) => b.dataset.group === g.dataset.group);
      const n = inGroup.filter((b) => b.checked).length;
      const count = g.querySelector<HTMLElement>(".hs-count")!;
      count.textContent = String(n);
      count.classList.toggle("hidden", n === 0);
      g.querySelector(".hs-total")!.textContent = `${inGroup.length} tình trạng`;
      g.hidden = inGroup.length === 0;
    });
    const affected = affectedGroups(Object.fromEntries(ids.map((id) => [id, "AT_RISK" as const])));
    $("hsSummary").textContent = ids.length
      ? `Đã chọn ${ids.length} dấu hiệu · ảnh hưởng: ${affected.map((g) => g.icon + " " + g.short).join(", ")}`
      : none.checked
        ? "Bé không có dấu hiệu bất thường."
        : "Hãy tích dấu hiệu, hoặc chọn “Bé không có dấu hiệu nào ở trên”.";
    ($("hsSave") as HTMLButtonElement).disabled = !ids.length && !none.checked;
  }

  boxes.forEach((b) =>
    b.addEventListener("change", () => {
      if (b.checked) none.checked = false;
      refresh();
    }),
  );
  none.addEventListener("change", () => {
    if (none.checked) visible().forEach((b) => (b.checked = false));
    refresh();
  });

  window.addEventListener("cham:health-modal", (e) => {
    const detail = (e as CustomEvent<{ id?: string; required?: boolean }>).detail ?? {};
    const child = useMemberStore.getState().children.find((c) => c.id === (detail.id ?? useMemberStore.activeChild()?.id));
    if (!child) return;
    childId = child.id;
    required = !!detail.required;
    const stage = stageOf(ageMonthsOf(child));
    boxes.forEach((b) => {
      const status = child.msk_checklist[Number(b.value)] ?? "NONE";
      const item = b.closest<HTMLElement>(".hs-item")!;
      // like the quick test: only items that fit the child's age, plus anything already recorded
      item.hidden = status === "NONE" && !item.dataset.stages!.split(" ").includes(stage);
      b.checked = status !== "NONE";
      item.querySelector(".hs-dx")!.classList.toggle("hidden", status !== "DIAGNOSED");
    });
    $("hsAgeNote").textContent = `${visible().length}/${boxes.length} dấu hiệu phù hợp nhóm tuổi ${STAGES.find((s) => s.id === stage)!.range} của bé — giống phần Test nhanh.`;
    none.checked = child.health_screening.screened && checkedIds().length === 0;
    notes.value = child.health_screening.notes;
    $("hsName").textContent = `· ${child.animal} ${child.nickname}`;
    $("hsStep").textContent = required ? "Bước 2/2 · bắt buộc để hoàn thiện hồ sơ" : "Hồ sơ thể trạng";
    $("hsClose").hidden = required;
    $("hsCancel").hidden = required;
    refresh();
    // open the groups that already have selections, plus the first visible one
    const first = groups.find((g) => !g.hidden);
    groups.forEach((g) => (g.open = g === first || !!g.querySelector(".hs-item:not([hidden]) input:checked")));
    dialog.showModal();
  });

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!childId || (!checkedIds().length && !none.checked)) return;
    useMemberStore.saveScreening(childId, visible().map((b) => Number(b.value)), checkedIds(), notes.value.trim());
    dialog.close();
  });

  // in required mode the only way out is saving
  dialog.addEventListener("cancel", (e) => required && e.preventDefault());
  dialog.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    if (required) return;
    if (t === dialog || t.id === "hsClose" || t.id === "hsCancel") dialog.close();
  });
</script>
