---
// One page per ward ("sân chơi trẻ em phường X") for local searches.
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import PlaceList from "../../components/PlaceList.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { KIND_LABEL, kindCounts, wards, type Ward } from "../../data/placeDirectory";
import { SITE_NAME, absUrl } from "../../config/site";
import { breadcrumbLd } from "../../lib/seo";

export function getStaticPaths() {
  return wards.filter((w) => w.hasPage).map((ward) => ({ params: { ward: ward.slug }, props: { ward } }));
}

const { ward } = Astro.props as { ward: Ward };
const base = import.meta.env.BASE_URL;
const counts = kindCounts(ward.places);
const summary = counts.map(([k, n]) => `${n} ${(KIND_LABEL[k] ?? KIND_LABEL.park).label.toLowerCase()}`).join(", ");
const title = `Sân chơi, công viên cho trẻ em ở ${ward.name}, Hà Nội`;
const description = `${ward.places.length} địa điểm cho bé vui chơi ngoài trời ở ${ward.name}: ${summary}. Kèm chỉ đường và gợi ý trò vận động theo độ tuổi.`;
const others = wards.filter((w) => w.hasPage && w.slug !== ward.slug).slice(0, 12);
const crumbs = [
  { name: "Trang chủ", href: "" },
  { name: "Sân chơi Hà Nội", href: "san-choi/" },
];
const jsonLd = [
  {
    "@type": "ItemList",
    name: title,
    url: absUrl(`san-choi/${ward.slug}`),
    numberOfItems: ward.places.length,
    itemListElement: ward.places.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": (KIND_LABEL[p.kind ?? "park"] ?? KIND_LABEL.park).schema,
        name: p.name,
        address: { "@type": "PostalAddress", streetAddress: p.address, addressLocality: ward.name, addressRegion: "Hà Nội", addressCountry: "VN" },
        geo: { "@type": "GeoCoordinates", latitude: p.lat, longitude: p.lng },
        ...(p.free === true && { isAccessibleForFree: true }),
      },
    })),
  },
  breadcrumbLd(crumbs, { name: ward.name, href: `san-choi/${ward.slug}` }),
];
---

<Layout title={`${title} · ${SITE_NAME}`} description={description} jsonLd={jsonLd}>
  <main class="safe-top px-4 max-w-2xl mx-auto space-y-4">
    <PageHeader title={title} crumbs={crumbs} />
    <p class="text-sm text-stone-600 leading-relaxed">
      {ward.name} có <b>{ward.places.length}</b> địa điểm vui chơi ngoài trời cho trẻ ({summary}).
      Mỗi địa điểm kèm gợi ý trò vận động cho bé 1–3, 4–6 và 7–10 tuổi. Hãy kiểm tra thực tế mặt sân và giờ mở cửa trước khi đi.
    </p>

    <PlaceList places={ward.places} />

    <p class="text-sm">
      <a href={base} class="text-emerald-700 font-semibold underline">Mở bảng vận động</a> để bấm giờ chơi ngoài trời và nhận gợi ý sân chơi hợp thể trạng của bé.
    </p>

    <nav aria-labelledby="others" class="space-y-2">
      <h2 id="others" class="text-base font-extrabold text-stone-800">Khu vực khác</h2>
      <ul class="flex flex-wrap gap-2 text-sm">
        {others.map((w) => <li><a href={`${base}san-choi/${w.slug}`} class="inline-block rounded-full bg-white border border-stone-200 px-3 py-1 hover:border-emerald-300">{w.name}</a></li>)}
        <li><a href={`${base}san-choi/`} class="inline-block rounded-full bg-emerald-50 border border-emerald-200 px-3 py-1 font-semibold text-emerald-800">Tất cả khu vực →</a></li>
      </ul>
    </nav>
  </main>
  <SiteFooter />
</Layout>
